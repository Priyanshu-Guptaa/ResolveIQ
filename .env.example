# Copy to .env and adjust as needed. All values are optional -- sane
# defaults are defined in app/config.py.

RESOLVEIQ_LOG_LEVEL=INFO
RESOLVEIQ_EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RESOLVEIQ_AUTO_SEED_KNOWLEDGE=true
RESOLVEIQ_SIMILARITY_TOP_K=5
RESOLVEIQ_MIN_SIMILARITY_FOR_ROOT_CAUSE=0.35

# --- Hosted deployment (see docker-compose.yml) --------------------------------
# Leave unset for local single-user use (SQLite + embedded Chroma, no login).
# RESOLVEIQ_DATABASE_URL=postgresql+psycopg://resolveiq:CHANGE_ME@postgres:5432/resolveiq
# RESOLVEIQ_CHROMA_HOST=chroma
# RESOLVEIQ_CHROMA_PORT=8000
# RESOLVEIQ_CHROMA_AUTH_TOKEN=CHANGE_ME
# RESOLVEIQ_EMBEDDING_BACKEND=onnx            # no torch; same vectors as sentence-transformers
# RESOLVEIQ_UPLOAD_BACKEND=local              # or s3 (+ RESOLVEIQ_UPLOAD_S3_BUCKET)
# RESOLVEIQ_AUTH_ENABLED=true
# RESOLVEIQ_AUTH_SECRET_KEY=                  # >= 32 random characters, e.g. `openssl rand -hex 32`
# RESOLVEIQ_AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
# RESOLVEIQ_AUTH_BOOTSTRAP_ADMIN_PASSWORD=    # used only while the users table is empty
# RESOLVEIQ_TFS_PERSONAL_ACCESS_TOKEN=        # replaces Windows SSPI auth on Linux hosts
# Compose-only variables:
# POSTGRES_PASSWORD=
# CHROMA_TOKEN=
